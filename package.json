{
  "name": "system-design-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "pnpm build:view && vite dev",
    "build": "pnpm build:view && vite build",
    "build:view": "node scripts/build-view.ts",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "oxlint --max-warnings 0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@excalidraw/excalidraw": "0.18.0-1118751",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "fractional-indexing": "^4.0.0",
    "partysocket": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "roughjs": "^4.6.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.59.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  },
  "packageManager": "pnpm@12.6.0"
}
