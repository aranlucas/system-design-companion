{
  "name": "system-design-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "pnpm build:view && vite dev",
    "build": "pnpm build:view && vite build",
    "build:view": "node scripts/build-view.ts",
    "check:bundle": "pnpm build && node scripts/check-bundle.ts",
    "deploy": "pnpm build && cf deploy --prebuilt",
    "lint": "oxlint --max-warnings 0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types",
    "build:preview": "pnpm build:view && CLOUDFLARE_VITE_PREVIEW_BUILD=true vite build",
    "deploy:preview": "pnpm build:preview && cf previews deploy --prebuilt"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@dagrejs/dagre": "^3.1.1",
    "@excalidraw/excalidraw": "0.18.0-1118751",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@tanstack/react-query": "^5.104.0",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.9",
    "ipaddr.js": "^2.5.0",
    "partysocket": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "roughjs": "^4.6.6",
    "webcola": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-ad79608dd",
    "@oxlint/plugins": "1.85.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cf": "1.0.0-beta.10",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@12.6.0"
}
