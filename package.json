{
  "name": "system-design-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "pnpm build:view && portless run vite dev",
    "build": "pnpm build:view && vite build",
    "build:view": "node scripts/build-view.ts",
    "check:bundle": "pnpm build && node scripts/check-bundle.ts",
    "deploy": "pnpm build && cf deploy --prebuilt",
    "lint": "oxlint --max-warnings 0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types",
    "build:preview": "pnpm build:view && CLOUDFLARE_VITE_PREVIEW_BUILD=true vite build",
    "deploy:preview": "pnpm build:preview && cf previews deploy --prebuilt"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@dagrejs/dagre": "^3.1.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@tanstack/react-query": "^5.104.2",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.13",
    "ipaddr.js": "^2.5.0",
    "partysocket": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "roughjs": "^4.6.6",
    "webcola": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.0",
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-c82c3efb3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.16",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  },
  "packageManager": "pnpm@12.11.2"
}
