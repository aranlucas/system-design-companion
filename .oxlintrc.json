{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json",
    "./node_modules/@aranlucas/oxforge/configs/react.json",
    "./node_modules/@aranlucas/oxforge/configs/vitest.json",
    "./node_modules/@aranlucas/oxforge/configs/type-aware.json"
  ],
  "jsPlugins": ["./lint/types-plugin.ts"],
  "plugins": ["eslint", "typescript", "react", "unicorn", "oxc", "import", "jsx-a11y", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/immutability": "error",
    "react/memo-dependencies": "error",
    "react/refs": "error",
    "react-hooks/exhaustive-deps": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-base-to-string": "error",
    "typescript/consistent-return": "error",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/no-array-sort": "error",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-set-has": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/no-useless-spread": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "import/no-named-as-default-member": "error",
    "oxc/no-map-spread": "off",
    "eslint/no-underscore-dangle": "error",
    "local/no-inline-types": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "oxc/no-accumulating-spread": "error",
    "eslint/curly": "off",
    "eslint/no-console": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/id-length": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-statements": "off",
    "eslint/func-style": "off",
    "eslint/no-inline-comments": "off",
    "eslint/no-negated-condition": "off",
    "eslint/new-cap": "off",
    "eslint/no-restricted-imports": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-code-point": "off",
    "unicorn/no-this-assignment": "off",
    "react/button-has-type": "off",
    "typescript/no-non-null-assertion": "off",
    "eslint/radix": "off",
    "anti-slop/no-array-filter-map": "off",
    "anti-slop/no-chained-type-assertions": "off",
    "anti-slop/no-conditional-empty-object-spread": "off",
    "anti-slop/no-known-value-widening": "off",
    "anti-slop/no-module-mocking": "off",
    "anti-slop/no-object-parameters": "off",
    "anti-slop/no-reduce-accumulator-copy": "off",
    "anti-slop/no-reflect-apply": "off",
    "anti-slop/no-reflect-get": "off",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "off",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-unknown-returns": "off",
    "anti-slop/no-unknown-type-aliases": "off",
    "anti-slop/no-unsafe-dictionary-type": "off",
    "anti-slop/no-widen-then-assert": "off",
    "anti-slop/require-readable-spacing": "off",
    "anti-slop/require-safety-comment-for-type-assertion": "off"
  },
  "overrides": [
    {
      "files": [
        "tests/helpers/strict-fake.ts",
        "tests/helpers/sqlite-d1.ts",
        "tests/helpers/awaited-rpc.ts",
        "src/app/validation.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true
          }
        ]
      }
    },
    {
      "files": ["src/worker/room.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "worker-configuration.d.ts",
    "public/mcp-view.html",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "options": {
    "typeAware": true
  }
}
