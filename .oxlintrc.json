{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json",
    "./node_modules/@aranlucas/oxforge/configs/react.json",
    "./node_modules/@aranlucas/oxforge/configs/vitest.json"
  ],
  "plugins": ["eslint", "typescript", "react", "unicorn", "oxc", "import", "jsx-a11y", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "eslint/no-underscore-dangle": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "test/helpers/strict-fake.ts",
        "test/helpers/sqlite-statement.ts",
        "test/helpers/awaited-rpc.ts",
        "src/app/validation.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true
          }
        ]
      }
    },
    {
      "files": ["src/worker/room.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "worker-configuration.d.ts",
    "public/mcp-view.html",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "options": {
    "typeAware": true
  }
}
